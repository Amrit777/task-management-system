# backend/.env.example — copy to .env and fill in real values. NEVER commit .env.
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=task-management-system
DB_DIALECT=postgres

# Schema sync strategy: alter | safe | off  (use migrations in production -> off)
DB_SYNC=alter

# Auth — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3005,http://localhost:5173

NODE_ENV=development
